{% extends "mailer/base.html.twig" %}

{% block chip %}Demande reçue{% endblock %}

{% block body %}
	<h1 style="font-size:24px;line-height:32px;margin:16px 0 8px;">Bonjour {{ loan.loaner.name ?? '' }} !</h1>
	<p style="font-size:15px;line-height:22px;color:#334155;margin:0;">Vous avez fait une demande d'emprunt de matériel sur MATOS. Voici un récapitulatif de votre demande :</p>
	{% include 'mailer/_recap.html.twig' with {loan: loan, itemsLabel: 'Matériel demandé'} %}
	<p style="font-size:15px;line-height:22px;color:#334155;margin:0;">Vous recevrez un mail lorsque votre demande sera traitée.</p>
{% endblock %}
