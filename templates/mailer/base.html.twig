<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Demande de matériel</title>
	</head>
	<body style="margin:0;padding:0;background-color:#F6F8FA;font-family:'Plus Jakarta Sans',Arial,Helvetica,sans-serif;color:#0B1622;">
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F6F8FA;">
			<tr>
				<td align="center" style="padding:32px 16px;">
					<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
						<tr>
							<td align="center" style="padding-bottom:20px;">
								<img src="{{ absolute_url(asset('logo.png')) }}" width="40" height="40" alt="" style="vertical-align:middle;">
								<span style="font-size:22px;font-weight:700;letter-spacing:.5px;vertical-align:middle;padding-left:8px;">MATOS</span>
							</td>
						</tr>
						<tr>
							<td style="background-color:#ffffff;border:1px solid #E5E9F0;border-radius:16px;padding:32px;">
								{% set chip = block('chip') is defined ? block('chip') : '' %}
								{% if chip is not empty %}
									<span style="display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600;{{ block('chipStyle') is defined ? block('chipStyle') : 'background-color:#E8F8FE;color:#0A6F96;' }}">{{ chip }}</span>
								{% endif %}
								{% block body %}{% endblock %}
							</td>
						</tr>
						<tr>
							<td align="center" style="padding-top:20px;font-size:12px;color:#64748B;line-height:18px;">
								Une question ? <a href="mailto:emprunt.mmi@gmail.com" style="color:#0A6F96;">emprunt.mmi@gmail.com</a><br>
								<span style="color:#94A3B8;">À bientôt sur MATOS · IUT de Troyes</span>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
