<section class="ea-card p-5">
	<div class="mb-1 flex items-center justify-between">
		<h2 class="m-0 text-lg font-bold">Demandes à traiter <span class="ml-1 rounded-full bg-warning px-2 py-0.5 text-xs font-semibold text-ink-900">{{ loans|length }}</span></h2>
	</div>
	<p class="mb-3 text-xs text-ink-500">Triées par date d'émission de la demande (la plus ancienne en haut).</p>
	{% for loan in loans %}
		{% set name = loan.loaner.name ?? loan.loaner.email|split('@')[0] %}
		{% set initials = '' %}{% for part in name|split(' ')|slice(0, 2) %}{% set initials = initials ~ part|first|upper %}{% endfor %}
		<div class="flex flex-wrap items-center gap-3 border-t border-surface-line py-3 md:flex-nowrap">
			<span class="ea-avatar">{{ initials }}</span>
			<div class="min-w-0 grow basis-32 md:basis-0">
				<p class="m-0 font-semibold text-ink-900">{{ name }}</p>
				<p class="m-0 text-xs text-ink-500">{{ loan.equipmentloaned[0].category ?? '' }} · {{ loan.equipmentloaned|length }} article{{ loan.equipmentloaned|length > 1 ? 's' : '' }}</p>
			</div>
			<div class="text-right text-sm text-ink-700">
				<p class="m-0">{{ loan.departuredate|date('d/m H:i') }} → {{ loan.returndate|date('d/m H:i') }}</p>
			</div>
			<a class="ea-btn ea-btn-light" href="{{ path('admin_loan_review', {'id': loan.id}) }}">Traiter <i class="fa fa-arrow-right"></i></a>
		</div>
	{% else %}
		<p class="m-0 rounded-xl border border-dashed border-surface-line p-6 text-center text-sm text-ink-500">Aucune demande en attente.</p>
	{% endfor %}
</section>
