{% import 'main/_icons.html.twig' as ui %}
<dialog id="confirmation_modal" class="modal modal-bottom sm:modal-middle">
	<div class="modal-box rounded-t-3xl p-6 sm:max-w-md sm:rounded-3xl">
		<h3 class="text-xl font-bold">Confirmer ta demande ?</h3>
		<p class="mt-1 text-sm text-ink-500">Vérifie le résumé avant d'envoyer.</p>
		<div class="mt-4 flex flex-col gap-3 rounded-2xl bg-surface-bg p-4 text-sm">
			<div id="confirmation_modal_creneau" class="font-semibold"></div>
			<div id="confirmation_modal_content" class="text-ink-700"></div>
		</div>
		<form method="dialog" class="mt-6 grid grid-cols-2 gap-3">
			<button class="btn h-12 border-0 bg-surface-muted">Retour</button>
			<button class="btn btn-neutral h-12" onclick="submitLoanForm()">Valider</button>
		</form>
	</div>
	<form method="dialog" class="modal-backdrop"><button>Fermer</button></form>
</dialog>
<dialog id="error_modal" class="modal modal-bottom sm:modal-middle">
	<div class="modal-box rounded-t-3xl p-6 text-center sm:max-w-sm sm:rounded-3xl">
		<span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-red-50 text-error">{{ ui.icon('info', 'h-6 w-6') }}</span>
		<h3 class="mt-4 text-xl font-bold">Oups</h3>
		<div id="error_modal_content" class="mt-2 text-sm text-ink-500"></div>
		<form method="dialog" class="mt-6">
			<button class="btn h-12 w-full border-0 bg-surface-muted">Retour</button>
		</form>
	</div>
	<form method="dialog" class="modal-backdrop"><button>Fermer</button></form>
</dialog>
