{% extends 'form/base.html.twig' %}
{% import 'form/_equipment.html.twig' as eq %}
{% import 'main/_icons.html.twig' as ui %}

{% set pageTitle = 'Emprunt casque VR' %}

{% block subtitle %}Casques de réalité virtuelle et mixte{% endblock %}

{% block modalites %}
	<p class="flex items-center gap-2 font-semibold text-brand-700">{{ ui.icon('info', 'h-4 w-4') }}Modalités</p>
	<ul class="mt-1 list-disc pl-10">
		<li>Les demandes doivent être faites au <b>minimum 24h à l'avance</b>.</li>
		<li>La durée maximale d'emprunt est de <b>1 semaine</b>.</li>
		<li>Vous recevrez un mail de confirmation dès que votre demande aura été traitée.</li>
	</ul>
	<p class="mt-3 flex items-center gap-2 font-semibold text-brand-700">{{ ui.icon('box', 'h-4 w-4') }}Fourni avec</p>
	<ul class="mt-1 list-disc pl-10">
		<li>Les casques sont fournis avec <b>leur chargeur</b> et <b>leur câble USB type C</b> (de charge et/ou de connexion).</li>
		<li>Des piles sont fournies dans les manettes (si applicable). Veuillez nous notifier lorsqu'elles sont bientôt vides.</li>
	</ul>
{% endblock %}

{% block equipment %}
	{{ eq.group(form_label(form.headset)|striptags, '1 au choix', eq.cards(form.headset, equipmentInfo), 'headset') }}
{% endblock %}
