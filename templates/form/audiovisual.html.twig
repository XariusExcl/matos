{% extends 'form/base.html.twig' %}
{% import 'form/_equipment.html.twig' as eq %}
{% import 'main/_icons.html.twig' as ui %}

{% set pageTitle = 'Emprunt audiovisuel' %}

{% block subtitle %}Caméras, objectifs, micros, lumières, trépieds et accessoires{% endblock %}

{% block modalites %}
	<p class="flex items-center gap-2 font-semibold text-brand-700">{{ ui.icon('info', 'h-4 w-4') }}Modalités</p>
	<ul class="mt-1 list-disc pl-10">
		<li>Les demandes doivent être faites au <b>minimum 24h à l'avance</b>.</li>
		<li>La durée maximale d'emprunt est de <b>1 jour</b> (emprunté le vendredi = rendu le lundi).</li>
		<li>Vous recevrez un mail de confirmation dès que votre demande aura été traitée.</li>
	</ul>
	<p class="mt-3 flex items-center gap-2 font-semibold text-brand-700">{{ ui.icon('box', 'h-4 w-4') }}Fourni avec</p>
	<ul class="mt-1 list-disc pl-10">
		<li>Les boîtiers sont fournis avec <b>leur chargeur</b> et <b>une batterie</b>.</li>
		<li>Les lumières sont fournies avec <b>une batterie V-mount</b> (si applicable), <b>leur adaptateur secteur</b> et <b>un trépied lumière</b>.</li>
	</ul>
{% endblock %}

{% block equipment %}
	<div class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1">
		{% for anchor, label in {cameras: 'Boîtier', lenses: 'Objectifs', microphones: 'Micros', lights: 'Lumières', tripods: 'Trépieds', stabilizers: 'Stabilisateurs', batteries: 'Batteries'} %}
			<button type="button" class="m-chip {{ loop.first ? 'm-chip-active' : '' }}" data-equipment-filter="group-{{ anchor }}">{{ label }}</button>
		{% endfor %}
	</div>
	{{ eq.group(form_label(form.cameras)|striptags, '1 au choix', eq.cards(form.cameras, equipmentInfo, 'Aucun', 'Pas de boîtier nécessaire pour ce projet.'), 'cameras') }}
	{% for field in ['lenses', 'microphones', 'lights', 'tripods', 'stabilizers', 'batteries'] %}
		{{ eq.group(form_label(form[field])|striptags, form[field].vars.multiple ? 'plusieurs possibles' : '1 au choix', eq.options(form[field], equipmentInfo), field) }}
	{% endfor %}
{% endblock %}
