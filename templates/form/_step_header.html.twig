{% import 'main/_icons.html.twig' as ui %}
<div class="flex items-center gap-3 px-4 py-4 md:px-6 md:py-5">
	<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-surface-muted text-sm font-semibold text-ink-500" data-step-num>{{ n }}</span>
	<span class="hidden text-success" data-step-done>{{ ui.icon('check-circle', 'h-6 w-6') }}</span>
	<div class="min-w-0 flex-1">
		<h2 class="text-lg font-bold md:text-xl">{{ n }}. {{ title }}</h2>
		<p class="hidden truncate text-sm font-semibold text-ink-700" data-step-summary></p>
	</div>
	<button type="button" class="hidden text-sm font-semibold text-brand-700" data-step-edit>Modifier</button>
</div>
