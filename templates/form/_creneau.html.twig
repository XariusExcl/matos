{% import 'main/_icons.html.twig' as ui %}
<div class="flex flex-col gap-6">
	{% for side in [
		{title: 'Départ', day: form.startDay, slot: form.startTimeSlot},
		{title: 'Retour', day: form.endDay, slot: form.endTimeSlot}
	] %}
		<div class="flex flex-col gap-3">
			<h3 class="font-semibold">{{ side.title }}</h3>
			<div class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1" data-choices-for="{{ side.day.vars.id }}" data-kind="day" role="group" aria-label="Jour de {{ side.title|lower }}"></div>
			<div class="flex gap-2" data-choices-for="{{ side.slot.vars.id }}" data-kind="slot" role="group" aria-label="Créneau horaire de {{ side.title|lower }}"></div>
			<div class="hidden">
				{{ form_label(side.day) }}{{ form_widget(side.day) }}
				{{ form_label(side.slot) }}{{ form_widget(side.slot) }}
			</div>
		</div>
	{% endfor %}
	<p id="creneau-error" class="flex scroll-mb-32 items-start gap-2 rounded-xl border border-red-200 bg-red-50 px-3 py-2.5 text-sm font-semibold text-error empty:hidden" role="alert">{{ form_errors(form.startDay) }}{{ form_errors(form.endDay) }}{{ form_errors(form.startTimeSlot) }}{{ form_errors(form.endTimeSlot) }}</p>
</div>
