{% extends 'form/base.html.twig' %}
{% import 'form/_equipment.html.twig' as eq %}
{% import 'main/_icons.html.twig' as ui %}

{% set pageTitle = 'Emprunt SAÉ' %}

{% set hasProject = false %}

{% block subtitle %}Un pack de matériel + un bonus optionnel · 1 demande par étudiant{% endblock %}

{% block modalites %}
	<p class="flex items-center gap-2 font-semibold text-brand-700">{{ ui.icon('info', 'h-4 w-4') }}Modalités</p>
	<ul class="mt-1 list-disc pl-10">
		<li>Les demandes doivent être faites au <b>minimum 24h à l'avance</b>.</li>
		<li>La durée maximale d'emprunt est de <b>1 jour</b>.</li>
		<li>Vous recevrez un mail de confirmation dès que votre demande aura été traitée.</li>
	</ul>
	<p class="mt-3 flex items-center gap-2 font-semibold text-brand-700">{{ ui.icon('box', 'h-4 w-4') }}Fourni avec</p>
	<ul class="mt-1 list-disc pl-10">
		<li>Les boîtiers sont fournis avec <b>leur chargeur</b> et <b>une batterie</b>.</li>
		<li>Les lumières sont fournies avec <b>une batterie V-mount</b> (si applicable), <b>leur adaptateur secteur</b> et <b>un trépied lumière</b>.</li>
	</ul>
{% endblock %}

{% block equipment %}
	{{ eq.group(form_label(form.packs)|striptags, '1 au choix', eq.cards(form.packs, equipmentInfo), 'packs') }}
	{{ eq.group(form_label(form.pack_bonus)|striptags, 'optionnel', eq.cards(form.pack_bonus, equipmentInfo, 'Aucun bonus', 'Pas de bonus pour ce pack.'), 'pack_bonus') }}
{% endblock %}
