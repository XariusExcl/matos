{% extends "base.html.twig" %}

{% block title %}MATOS Emprunt #{{ loan.id }}{% endblock %}

{% block body %}
<style>
	html, body { background-color: white !important; }
	@media print { .no-print, .no-print * { display: none !important; } }
</style>
{% if loan.status != 1 %}
	<div class="mx-auto max-w-xl p-10 text-center">
		<p class="text-lg font-semibold">Erreur, cet emprunt n'est pas/plus valide !</p>
		<small class="text-ink-500">MATOS - IUT de Troyes - {{ "now"|date('Y') }}</small>
	</div>
{% else %}
	<p class="no-print my-5 text-center text-sm italic text-ink-500">
		Pour imprimer cette page, cliquez sur le bouton d'impression de votre navigateur ou appuyez sur <kbd class="kbd kbd-sm">Ctrl</kbd> + <kbd class="kbd kbd-sm">P</kbd>.
	</p>
	<div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-[794px] flex-col gap-7 bg-white px-10 py-12 text-black print:min-h-screen print:p-8">
		<header class="flex items-start justify-between gap-6 border-b-2 border-black pb-6">
			<div class="flex items-center gap-4">
				<img src="{{ asset('logo_bw_lowink.png') }}" alt="Logo" class="h-20 w-20">
				<div>
					<p class="text-2xl font-bold">MATOS</p>
					<p class="text-sm">IUT de Troyes · Département MMI</p>
				</div>
			</div>
			<div class="text-right">
				<p class="text-lg font-semibold">Fiche d'emprunt</p>
				<p class="text-3xl font-extrabold">N° {{ loan.id }}</p>
			</div>
		</header>

		<section class="grid grid-cols-3 gap-6">
			<div>
				<p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Emprunteur</p>
				<p class="mt-1 font-semibold">{{ loan.loaner.name }}</p>
				<p class="text-sm">{{ loan.loaner.email }}</p>
			</div>
			<div>
				<p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Départ</p>
				<p class="mt-1 font-semibold">{{ loan.departureDate|date('d/m/Y') }}</p>
				<p class="text-sm">{{ loan.departureDate|date('H:i') }}</p>
			</div>
			<div>
				<p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Retour</p>
				<p class="mt-1 font-semibold">{{ loan.returnDate|date('d/m/Y') }}</p>
				<p class="text-sm">{{ loan.returnDate|date('H:i') }}</p>
			</div>
		</section>

		<section>
			<p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Matériel emprunté</p>
			<ul class="mt-2">
				{% for equipment in loan.equipmentLoaned %}
					<li class="flex items-center gap-4 border-t border-gray-300 py-3">
						<span class="h-5 w-5 shrink-0 rounded border-2 border-gray-600"></span>
						<span>{{ equipment.name }}{% if loan.discriminators[equipment.id] is defined %} (N°{{ loan.discriminators[equipment.id] }}){% endif %}</span>
					</li>
				{% endfor %}
			</ul>
		</section>

		<section>
			<p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Commentaire</p>
			<p class="mt-2">{% if loan.comment %}{{ loan.comment }}{% else %}<i>Aucun</i>{% endif %}</p>
		</section>

		<footer class="mt-auto flex flex-col items-center gap-1 text-center text-xs text-gray-600">
			<p>Imprimez ce document en noir et blanc, en pleine page au format A4 ou A5 (demi A4). Document conçu avec conscience écologique sur le site {{ url('app_main') }}.</p>
			<p>MATOS - #{{ loan.id }} - IUT de Troyes - {{ loan.departureDate|date('Y') }}</p>
		</footer>
	</div>
{% endif %}
{% endblock %}
