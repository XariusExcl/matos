{% import 'main/_icons.html.twig' as ui %}
{% set active = active|default('') %}
{% set bookSlug = saeMode|default(false) ? 'audiovisual_sae' : 'audiovisual' %}
{% if app.user %}
	{% set displayName = app.user.name ?? app.user.email|split('@')[0] %}
	{% set initials = '' %}
	{% for part in displayName|split(' ')|slice(0, 2) %}{% set initials = initials ~ part|first|upper %}{% endfor %}
{% endif %}
<header class="sticky top-0 z-30 border-b border-surface-line bg-white/95 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-6xl items-center gap-8 px-4 md:h-[72px] md:px-6">
		<a href="{{ path('app_main') }}" class="flex items-center gap-2" aria-label="MATOS, accueil">
			<img class="h-8 w-8" src="{{ asset('logo.png') }}" alt="">
			<span class="text-xl font-bold tracking-wide">MATOS</span>
		</a>
		<nav class="hidden flex-1 items-center gap-2 md:flex" aria-label="Navigation principale">
			{% for item in [
				{key: 'home', label: 'Accueil', url: path('app_main')},
				{key: 'book', label: 'Réserver', url: path('reservation_form', {formSlug: bookSlug})},
				{key: 'loans', label: 'Mes emprunts', url: path('app_myloans')}
			] %}
				{% if item.key != 'loans' or app.user %}
					<a href="{{ item.url }}" class="rounded-full px-3.5 py-2 text-sm font-semibold {{ active == item.key ? 'bg-surface-muted text-ink-900' : 'text-ink-500 hover:text-ink-900' }}" {% if active == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a>
				{% endif %}
			{% endfor %}
		</nav>
		<div class="ml-auto flex items-center gap-3">
			{% if is_granted('ROLE_ADMIN') %}
				<a href="{{ path('admin') }}" class="hidden items-center gap-1.5 rounded-full bg-ink-900 px-3 py-1.5 text-xs font-semibold text-white sm:flex">{{ ui.icon('shield', 'h-4 w-4') }}Admin</a>
			{% endif %}
			{% if app.user %}
				<div class="dropdown dropdown-end">
					<div tabindex="0" role="button" class="flex items-center gap-2.5 rounded-full p-1 pr-1 md:pr-3 hover:bg-surface-muted">
						<span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700">{{ initials }}</span>
						<span class="hidden text-sm font-semibold md:inline">{{ displayName }}</span>
					</div>
					<ul tabindex="0" class="menu dropdown-content z-40 mt-2 w-56 rounded-2xl border border-surface-line bg-white p-2 shadow-float">
						<li class="menu-title text-ink-900">{{ displayName }}</li>
						<li><a href="{{ path('app_myloans') }}">{{ ui.icon('clipboard', 'h-4 w-4') }}Mes emprunts</a></li>
						{% if is_granted('ROLE_ADMIN') %}
							<li class="sm:hidden"><a href="{{ path('admin') }}">{{ ui.icon('shield', 'h-4 w-4') }}Admin</a></li>
						{% endif %}
						<li><a href="{{ logout_path(key = null) }}">{{ ui.icon('logout', 'h-4 w-4') }}Se déconnecter</a></li>
					</ul>
				</div>
			{% else %}
				<a href="{{ path('login') }}" class="btn btn-neutral btn-sm h-10 px-4">Se connecter</a>
			{% endif %}
		</div>
	</div>
</header>
{% set flashes = app.flashes(['error', 'success', 'info']) %}
{% if flashes|filter(list => list is not empty) is not empty %}
	<div class="mx-auto mt-4 flex max-w-6xl flex-col gap-2 px-4 md:px-6">
		{% for type, messages in flashes %}
			{% for message in messages %}
				{% include 'main/flash.html.twig' with {'type': type, 'message': message} %}
			{% endfor %}
		{% endfor %}
	</div>
{% endif %}
