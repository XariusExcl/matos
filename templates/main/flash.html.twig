{% import 'main/_icons.html.twig' as ui %}
{% set styles = {
	'error': 'border-error bg-red-50 text-error',
	'success': 'border-success bg-emerald-50 text-success',
	'warning': 'border-warning bg-amber-50 text-amber-700',
	'info': 'border-brand-500 bg-brand-50 text-brand-700'
} %}
<div role="alert" class="flex items-center gap-3 rounded-2xl border px-4 py-3 {{ styles[type]|default(styles.info) }}">
	{{ ui.icon(type == 'success' ? 'check-circle' : 'info', 'h-5 w-5 shrink-0') }}
	<span class="flex-1 text-sm font-semibold text-ink-900">{{ message }}</span>
	<button type="button" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-ink-700 hover:bg-black/5" onclick="this.parentElement.remove()" aria-label="Fermer">
		{{ ui.icon('x', 'h-4 w-4') }}
	</button>
</div>
