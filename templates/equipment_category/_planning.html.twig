{% set perDay = perDay|default(2) %}
{% set endInclusive = endInclusive ?? true %}
{% set slotLabels = slotLabels|default(['Matin', 'Après-midi']) %}
{% set totalSlots = dates|length * perDay %}
{% set unavailableDays = unavailableDays|default([]) %}
{% set showOwner = loan_show_owner_on_table %}

<div class="hidden overflow-x-auto rounded-2xl border border-surface-line bg-white md:block" data-planning="desktop">
	<div class="grid min-w-[880px]" style="grid-template-columns: 200px repeat({{ totalSlots }}, minmax(36px, 1fr));">
		<div class="sticky left-0 z-10 flex items-center border-b border-surface-line bg-surface-bg px-4 text-xs font-medium text-ink-500" style="grid-row: 1 / 3; grid-column: 1;">Équipement</div>
		{% set shortLabels = perDay == 3 ? ['Matin', 'Aprèm', 'Soir'] : ['Matin', 'Aprèm'] %}
		{% for date in dates %}
			{% set i = loop.index0 %}
			<div class="flex items-center justify-center border-l border-surface-line bg-surface-bg pt-2.5" style="grid-row: 1; grid-column: {{ i * perDay + 2 }} / span {{ perDay }};">
				<span class="text-sm font-semibold">{{ date|split(' ')|first|slice(0, 3) }}. {{ date|split(' ')|last }}</span>
			</div>
			{% for label in shortLabels %}
				<div class="border-b border-surface-line bg-surface-bg pb-2 pt-0.5 text-center text-[11px] text-ink-400 {{ loop.first ? 'border-l' : '' }}" style="grid-row: 2; grid-column: {{ i * perDay + 1 + loop.index }};">{{ label }}</div>
			{% endfor %}
		{% endfor %}

		{% for e in equipment %}
			{% set row = loop.index0 + 3 %}
			<div class="sticky left-0 z-10 flex items-center border-b border-surface-line bg-white px-4 py-3 text-sm font-semibold" style="grid-row: {{ row }}; grid-column: 1;">{{ e.name }}</div>
			<div class="planning-lane border-b border-surface-line" style="grid-row: {{ row }}; grid-column: 2 / -1; background-size: calc(100% / {{ dates|length }}) 100%;"></div>
			{% for u in unavailableDays %}
				<div class="{{ u.preventsLoans ? 'bg-surface-muted' : 'bg-[repeating-linear-gradient(45deg,#F1F5F9,#F1F5F9_6px,transparent_6px,transparent_12px)]' }}" style="grid-row: {{ row }}; grid-column: {{ u.slotStart + 2 }} / {{ u.slotEnd + 3 }};" title="{{ u.comment }} {{ u.timeStartEnd }}"></div>
			{% endfor %}
			{% for loan in (loans[e.id] ?? []) %}
				{% if loan.status == 0 or loan.status == 1 %}
					{% set colEnd = endInclusive ? loan.end + 3 : loan.end + 2 %}
					<div class="z-[1] my-2 mx-0.5 flex items-center overflow-hidden rounded-lg px-2 text-xs font-medium {{ loan.status == 0 ? 'bg-warning text-ink-900' : 'bg-ink-900 text-white' }}" style="grid-row: {{ row }}; grid-column: {{ loan.start + 2 }} / {{ colEnd }};" title="{{ showOwner ? loan.info : (loan.status == 0 ? 'En attente' : 'Réservé') }}">
						{% if showOwner %}<span class="truncate">{{ loan.info|split(' (')|first }}</span>{% endif %}
					</div>
				{% endif %}
			{% endfor %}
		{% endfor %}
	</div>
</div>

<div class="md:hidden" data-planning="mobile">
	<div class="mb-3 flex gap-2 overflow-x-auto pb-1" role="tablist" aria-label="Jour du planning">
		{% for date in dates %}
			<button type="button" role="tab" class="m-day min-w-[60px] flex-none" data-planning-day="{{ loop.index0 }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">
				<span class="text-xs">{{ date|split(' ')|first|slice(0, 3)|lower }}.</span>
				<span class="text-xl font-bold">{{ date|split(' ')|last|split('/')|first }}</span>
			</button>
		{% endfor %}
	</div>
	{% for date in dates %}
		{% set d = loop.index0 %}
		<div class="overflow-hidden rounded-2xl border border-surface-line bg-white {{ loop.first ? '' : 'hidden' }}" data-planning-panel="{{ d }}">
			<div class="grid border-b border-surface-line bg-surface-bg text-xs font-medium text-ink-500" style="grid-template-columns: minmax(0, 1.4fr) repeat({{ perDay }}, minmax(0, 1fr));">
				<div class="px-3 py-2.5 font-semibold text-ink-900">{{ date }}</div>
				{% for label in slotLabels %}<div class="border-l border-surface-line px-3 py-2.5">{{ label }}</div>{% endfor %}
			</div>
			{% for e in equipment %}
				<div class="grid border-b border-surface-line last:border-b-0" style="grid-template-columns: minmax(0, 1.4fr) repeat({{ perDay }}, minmax(0, 1fr));">
					<div class="truncate px-3 py-3 text-sm font-semibold">{{ e.name }}</div>
					{% for k in 0..(perDay - 1) %}
						{% set s = d * perDay + k %}
						{% set found = null %}
						{% for loan in (loans[e.id] ?? []) %}
							{% set last = endInclusive ? loan.end : loan.end - 1 %}
							{% if (loan.status == 0 or loan.status == 1) and loan.start <= s and s <= last %}{% set found = loan %}{% endif %}
						{% endfor %}
						{% set closed = false %}
						{% for u in unavailableDays %}{% if u.preventsLoans and u.slotStart <= s and s <= u.slotEnd %}{% set closed = true %}{% endif %}{% endfor %}
						<div class="flex items-center border-l border-surface-line px-1">
							{% if found %}
								<span class="flex h-7 w-full items-center truncate rounded-md px-2 text-xs font-medium {{ found.status == 0 ? 'bg-warning text-ink-900' : 'bg-ink-900 text-white' }}">{{ showOwner ? found.info|split(' (')|first : (found.status == 0 ? 'En attente' : 'Réservé') }}</span>
							{% elseif closed %}
								<span class="px-2 text-xs text-ink-400">Fermé</span>
							{% else %}
								<span class="px-2 text-xs text-ink-300">Libre</span>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			{% endfor %}
		</div>
	{% endfor %}
</div>

<div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-ink-700">
	<span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-ink-900"></span>Réservé</span>
	<span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-warning"></span>En attente</span>
	<span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-surface-muted ring-1 ring-surface-line"></span>Fermé</span>
</div>

<script>
	document.querySelectorAll('[data-planning-day]').forEach((button) => {
		button.addEventListener('click', () => {
			const day = button.dataset.planningDay;
			document.querySelectorAll('[data-planning-day]').forEach((b) => b.setAttribute('aria-pressed', b === button ? 'true' : 'false'));
			document.querySelectorAll('[data-planning-panel]').forEach((p) => p.classList.toggle('hidden', p.dataset.planningPanel !== day));
		});
	});
</script>
